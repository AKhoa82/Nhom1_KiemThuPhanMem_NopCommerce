# Copy to .env locally only if your shell loads .env files. Do not commit credentials.
# Playwright itself reads the values from the environment.
QA_REGISTERED_EMAIL=qa.pairwise.registered@example.test
QA_REGISTERED_PASSWORD=

# Fixture paths created in setup.md. Override if the local slugs differ.
QA_SIMPLE_PRODUCT_PATH=/pw-simple-stock
QA_CONFIGURABLE_PRODUCT_PATH=/pw-shirt-variants
QA_OUT_OF_STOCK_PRODUCT_PATH=/pw-out-of-stock

# Local SQL Server credential for scripts/reset-fixture.ps1. Never commit it.
QA_SQL_PASSWORD=
QA_DB_CONTAINER=nopcommerce_mssql_server
QA_DB_NAME=nopcommerce
QA_STORE_CONTAINER=nopcommerce_qa

# Required only for rows that continue to checkout.
QA_BILLING_FIRST_NAME=QA
QA_BILLING_LAST_NAME=Customer
QA_BILLING_EMAIL=qa.guest@example.test
QA_BILLING_CITY=Ho Chi Minh City
QA_BILLING_ADDRESS1=1 Test Street
QA_BILLING_ZIP=700000
QA_BILLING_PHONE=0900000000
QA_BILLING_COUNTRY=Vietnam
QA_BILLING_STATE=Hồ Chí Minh
